{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "tooling-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "ISLE_ENABLE_SANITIZERS": false
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "tooling-base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Ninja Debug ROM tooling",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Ninja Release ROM tooling",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "tooling-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows VS 2022 x64 Debug ROM tooling",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows VS 2022 x64 Release ROM tooling",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    },
    {
      "name": "windows-host-release",
      "displayName": "Windows MSVC x64 static-runtime LUS, audio, RSP and native engine",
      "inherits": "windows-base",
      "toolchainFile": "$env{ISLE_WINDOWS_VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_ROOT": "$env{ISLE_WINDOWS_VCPKG_ROOT}",
        "VCPKG_DISABLE_METRICS": "1",
        "VCPKG_BINARY_SOURCES": "clear"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/cmake/windows-host",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static",
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_MANIFEST_INSTALL": true,
        "VCPKG_APPLOCAL_DEPS": false,
        "USE_AUTO_VCPKG": false,
        "ISLE_BUILD_HOST_PROBE": true,
        "ISLE_BUILD_AUDIO_PROBE": true,
        "ISLE_BUILD_RSP_PROBE": true,
        "ISLE_BUILD_GAME_ENGINE": true,
        "ISLE_LUS_SOURCE_DIR": "",
        "ISLE_SNAP_SOURCE_DIR": ""
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "windows-host-release",
      "configurePreset": "windows-host-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "synthetic-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "synthetic-base",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "inherits": "synthetic-base",
      "configurePreset": "linux-release"
    },
    {
      "name": "windows-debug",
      "inherits": "synthetic-base",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "inherits": "synthetic-base",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "windows-host-release",
      "inherits": "synthetic-base",
      "configurePreset": "windows-host-release",
      "configuration": "Release"
    }
  ]
}
