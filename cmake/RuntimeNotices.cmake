# Preserve file-level notices from the actual selected build inputs. This is
# not R1/R2 release approval: embedded terms, linkage and corresponding-source
# obligations still require review of the complete candidate composition.
function(isle_install_runtime_notices root label)
    set(notice_count 0)
    if(NOT IS_DIRECTORY "${root}")
        if(ARGC GREATER 2)
            set("${ARGV2}" 0 PARENT_SCOPE)
        endif()
        return()
    endif()
    file(GLOB_RECURSE notices LIST_DIRECTORIES FALSE "${root}/*")
    foreach(notice IN LISTS notices)
        file(RELATIVE_PATH relative "${root}" "${notice}")
        get_filename_component(name "${notice}" NAME)
        string(TOLOWER "${relative}" lower_relative)
        string(TOLOWER "${name}" lower_name)
        # License-prefixed scripts and checker configuration are not notices.
        if(lower_name MATCHES "\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|s|sh|bash|py|pl|rb|ps1|bat|cmd|js|ts|cmake|cfg|conf|ini|json|yaml|yml|toml)$")
            continue()
        endif()
        if(lower_name MATCHES "^(license|licenseref|copying|copyright|notice|credits)([._-].*)?$"
           OR lower_name MATCHES "\\.(license|spdx)$"
           OR lower_relative MATCHES "(^|/)(licenses?|copying([._-][^/]*)?)/")
            get_filename_component(directory "${relative}" DIRECTORY)
            install(FILES "${notice}" DESTINATION
                "${CMAKE_INSTALL_DATADIR}/licenses/35mmisle/dependencies/${label}/${directory}"
                COMPONENT Runtime)
            math(EXPR notice_count "${notice_count} + 1")
        endif()
    endforeach()
    if(ARGC GREATER 2)
        set("${ARGV2}" "${notice_count}" PARENT_SCOPE)
    endif()
endfunction()

isle_install_runtime_notices("${_isle_lus_private}" libultraship)
isle_install_runtime_notices("${ISLE_RSP_NOTICES}" parallel-rsp)
isle_install_runtime_notices("${_isle_rdp_private}/notices" parallel-rdp)
foreach(dependency IN ITEMS ImGui ThreadPool prism monocypher)
    FetchContent_GetProperties(${dependency} SOURCE_DIR notice_source)
    isle_install_runtime_notices("${notice_source}" "${dependency}")
endforeach()
set(_isle_runtime_notice_prefixes "")
foreach(prefix IN LISTS CMAKE_PREFIX_PATH)
    file(REAL_PATH "${prefix}" notice_prefix)
    # System package terms are selected at install time by binary ownership,
    # never by recursively scanning the machine's complete documentation tree.
    if(notice_prefix STREQUAL "/" OR notice_prefix STREQUAL "/usr")
        continue()
    endif()
    isle_install_runtime_notices("${notice_prefix}/share/doc" sdk doc_count)
    isle_install_runtime_notices("${notice_prefix}/share/licenses" sdk license_count)
    if(doc_count GREATER 0 OR license_count GREATER 0)
        list(APPEND _isle_runtime_notice_prefixes "${notice_prefix}")
    endif()
endforeach()
if(VCPKG_INSTALLED_DIR AND VCPKG_TARGET_TRIPLET)
    isle_install_runtime_notices("${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share" vcpkg)
endif()
