# Preserve file-level notices from the actual selected build inputs. This is
# not R1/R2 release approval or corresponding-source/relink delivery. The scoped
# preparation below separately checks embedded and in-file permissive terms.
function(isle_install_runtime_notices root label)
    set(notice_count 0)
    if(NOT IS_DIRECTORY "${root}")
        if(ARGC GREATER 2)
            set("${ARGV2}" 0 PARENT_SCOPE)
        endif()
        return()
    endif()
    file(GLOB_RECURSE notices LIST_DIRECTORIES FALSE "${root}/*")
    foreach(notice IN LISTS notices)
        file(RELATIVE_PATH relative "${root}" "${notice}")
        get_filename_component(name "${notice}" NAME)
        string(TOLOWER "${relative}" lower_relative)
        string(TOLOWER "${name}" lower_name)
        # License-prefixed scripts and checker configuration are not notices.
        if(lower_name MATCHES "\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|s|sh|bash|py|pl|rb|ps1|bat|cmd|js|ts|cmake|cfg|conf|ini|json|yaml|yml|toml)$")
            continue()
        endif()
        if(lower_name MATCHES "^(license|licence|licenseref|copying|copyright|notice|credits)([._-].*)?$"
           OR lower_name MATCHES "\\.(license|licence|spdx)$"
           OR lower_relative MATCHES "(^|/)(licen[sc]es?|copying([._-][^/]*)?)/")
            get_filename_component(directory "${relative}" DIRECTORY)
            install(FILES "${notice}" DESTINATION
                "${CMAKE_INSTALL_DATADIR}/licenses/35mmisle/dependencies/${label}/${directory}"
                COMPONENT Runtime)
            math(EXPR notice_count "${notice_count} + 1")
        endif()
    endforeach()
    if(ARGC GREATER 2)
        set("${ARGV2}" "${notice_count}" PARENT_SCOPE)
    endif()
endfunction()

# No network access or host-wide search: verify the exact selected inputs and
# prepare bounded license-only excerpts before declaring their Runtime installs.
find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
FetchContent_GetProperties(ImGui SOURCE_DIR _isle_notice_imgui)
FetchContent_GetProperties(monocypher SOURCE_DIR _isle_notice_monocypher)
get_target_property(_isle_notice_json_includes nlohmann_json::nlohmann_json INTERFACE_INCLUDE_DIRECTORIES)
set(_isle_notice_json_root "")
foreach(directory IN LISTS _isle_notice_json_includes)
    if(IS_DIRECTORY "${directory}" AND EXISTS "${directory}/nlohmann/json.hpp")
        if(_isle_notice_json_root AND NOT directory STREQUAL _isle_notice_json_root)
            message(FATAL_ERROR "Ambiguous selected nlohmann_json include roots for Runtime notices")
        endif()
        set(_isle_notice_json_root "${directory}")
    endif()
endforeach()
if(NOT _isle_notice_json_root)
    message(FATAL_ERROR "Cannot identify selected nlohmann_json headers for Runtime notices")
endif()
set(_isle_notice_manifest "${CMAKE_CURRENT_LIST_DIR}/runtime-notice-inputs.json")
set(_isle_notice_helper "${CMAKE_CURRENT_LIST_DIR}/../tools/prepare_runtime_notices.py")
set(_isle_notice_output "${CMAKE_BINARY_DIR}/runtime-notices/scoped")
set(_isle_notice_command
    "${Python3_EXECUTABLE}" "${_isle_notice_helper}"
    --manifest "${_isle_notice_manifest}"
    --lus "${_isle_lus_private}"
    --imgui "${_isle_notice_imgui}"
    --monocypher "${_isle_notice_monocypher}"
    --stb "${CMAKE_BINARY_DIR}/_deps/stb"
    --json "${_isle_notice_json_root}"
    --json-version "${nlohmann_json_VERSION}"
    --output "${_isle_notice_output}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_isle_notice_manifest}" "${_isle_notice_helper}")
execute_process(COMMAND ${_isle_notice_command} RESULT_VARIABLE _isle_notice_result)
if(NOT _isle_notice_result EQUAL 0)
    message(FATAL_ERROR "Could not prepare exact selected Runtime notices")
endif()
# Recheck source identities and generated bytes on every build, not merely the
# configure that originally prepared the notices. Installation also rechecks.
add_custom_target(isle-runtime-notice-provenance ALL
    COMMAND ${_isle_notice_command} --check
    COMMENT "Checking pinned Runtime notice and embedded-font provenance"
    VERBATIM)
add_dependencies(35mmisle isle-runtime-notice-provenance)
set(_isle_notice_preinstall [=[
    set(_isle_notice_command [==[@_isle_notice_command@]==])
    execute_process(COMMAND ${_isle_notice_command} --check RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Runtime notice inputs or prepared staging changed")
    endif()
]=])
string(CONFIGURE "${_isle_notice_preinstall}" _isle_notice_preinstall @ONLY)
install(CODE "${_isle_notice_preinstall}" COMPONENT Runtime)
file(GLOB_RECURSE _isle_scoped_notices LIST_DIRECTORIES FALSE "${_isle_notice_output}/*")
foreach(notice IN LISTS _isle_scoped_notices)
    file(RELATIVE_PATH relative "${_isle_notice_output}" "${notice}")
    get_filename_component(directory "${relative}" DIRECTORY)
    install(FILES "${notice}" DESTINATION
        "${CMAKE_INSTALL_DATADIR}/licenses/35mmisle/dependencies/scoped/${directory}"
        COMPONENT Runtime)
endforeach()
if(IS_ABSOLUTE "${CMAKE_INSTALL_DATADIR}")
    set(_isle_notice_installed "\$ENV{DESTDIR}${CMAKE_INSTALL_DATADIR}/licenses/35mmisle/dependencies/scoped")
else()
    set(_isle_notice_installed "\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_DATADIR}/licenses/35mmisle/dependencies/scoped")
endif()
set(_isle_notice_postinstall [=[
    set(_isle_notice_command [==[@_isle_notice_command@]==])
    execute_process(COMMAND ${_isle_notice_command} --installed "@_isle_notice_installed@"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Installed Runtime notice payload differs from pinned inputs")
    endif()
]=])
string(CONFIGURE "${_isle_notice_postinstall}" _isle_notice_postinstall @ONLY)
install(CODE "${_isle_notice_postinstall}" COMPONENT Runtime)

isle_install_runtime_notices("${_isle_lus_private}" libultraship)
isle_install_runtime_notices("${ISLE_RSP_NOTICES}" parallel-rsp)
isle_install_runtime_notices("${_isle_rdp_private}/notices" parallel-rdp)
foreach(dependency IN ITEMS ImGui ThreadPool prism monocypher)
    FetchContent_GetProperties(${dependency} SOURCE_DIR notice_source)
    isle_install_runtime_notices("${notice_source}" "${dependency}")
endforeach()
set(_isle_runtime_notice_prefixes "")
foreach(prefix IN LISTS CMAKE_PREFIX_PATH)
    file(REAL_PATH "${prefix}" notice_prefix)
    # System package terms are selected at install time by binary ownership,
    # never by recursively scanning the machine's complete documentation tree.
    if(notice_prefix STREQUAL "/" OR notice_prefix STREQUAL "/usr")
        continue()
    endif()
    isle_install_runtime_notices("${notice_prefix}/share/doc" sdk doc_count)
    isle_install_runtime_notices("${notice_prefix}/share/licenses" sdk license_count)
    if(doc_count GREATER 0 OR license_count GREATER 0)
        list(APPEND _isle_runtime_notice_prefixes "${notice_prefix}")
    endif()
endforeach()
if(VCPKG_INSTALLED_DIR AND VCPKG_TARGET_TRIPLET)
    isle_install_runtime_notices("${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share" vcpkg)
endif()
