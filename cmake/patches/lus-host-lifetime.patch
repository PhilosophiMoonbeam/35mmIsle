+namespace {
+struct GameImageRect {
+    ImVec2 offset;
+    ImVec2 size;
+};
+
+GameImageRect GetAspectFitRect(ImVec2 available, float aspect) {
+    available.x = available.x > 0.0f ? available.x : 0.0f;
+    available.y = available.y > 0.0f ? available.y : 0.0f;
+    ImVec2 size = available;
+    if (size.x > size.y * aspect) {
+        size.x = size.y * aspect;
+    } else {
+        size.y = size.x / aspect;
+    }
+    return { ImVec2((available.x - size.x) * 0.5f, (available.y - size.y) * 0.5f), size };
+}
