+void ControlDeck::ReleaseHostReferences() {
+    for (auto& port : mPorts) {
+        if (auto controller = port->GetConnectedController()) {
+            controller->SetControlDeck(nullptr);
+        }
+    }
+    mPorts.clear();
+    mWheelHandler.reset();
+    mWindow.reset();
+    mControllerBits = nullptr;
 }
 
