 void Gui::ShutDownImGui(Ship::Window* window) {
+    if (ImGui::GetCurrentContext() == nullptr) {
+        return;
+    }
     ImGuiWMShutdown();
     ImGuiBackendShutdown();
     ImGui::DestroyContext();
+}
+
+void Gui::ReleaseHostReferences() {
+    RemoveAllGuiWindows();
+    GetChildren().Remove(true);
+    mGameOverlay.reset();
+    mMenuBar.reset();
+    mMenu.reset();
+    mWindow.reset();
 }
 
